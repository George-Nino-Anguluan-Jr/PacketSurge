    "fix_syntax": [
      {
        "id": "py_lists_fix_1",
        "prompt": "Fix the syntax errors:",
        "code": "fruits = [\"apple\", \"banana\", \"cherry\"]\nprint(fruits[3])",
        "answer": "fruits = [\"apple\", \"banana\", \"cherry\"]\nprint(fruits[2])",
        "explanation": "Index 3 is out of range for 3-element list. Valid indices: 0, 1, 2.",
        "hints": ["List has 3 elements", "Max index is length - 1"]
      },
      {
        "id": "py_lists_fix_2",
        "prompt": "Fix the code to add 'orange' to the list:",
        "code": "fruits = [\"apple\", \"banana\"]\nfruits.add(\"orange\")",
        "answer": "fruits = [\"apple\", \"banana\"]\nfruits.append(\"orange\")",
        "explanation": "Lists use append(), not add().",
        "hints": ["Method is append()", "Not add()"]
      }
    ],
    "fix_and_optimize": [
      {
        "id": "py_lists_opt_1",
        "prompt": "Optimize - create list of 0 to 9:",
        "code": "nums = []\nfor i in range(10):\n    nums.append(i)",
        "answer": "nums = list(range(10))",
        "explanation": "list(range(n)) directly creates [0, 1, ..., n-1].",
        "hints": ["range() generates sequence", "list() converts to list"]
      }
