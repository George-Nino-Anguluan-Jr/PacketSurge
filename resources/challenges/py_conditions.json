        "id": "py_conditions_fix_1",
        "prompt": "Fix the syntax - missing colon and indentation:",
        "code": "if x > 5\nprint(\"Greater\")",
        "answer": "if x > 5:\n    print(\"Greater\")",
        "explanation": "If statements need colon and indented body.",
        "hints": ["Add colon after condition", "Indent the body"]
      },
      {
        "id": "py_conditions_fix_2",
        "prompt": "Fix the comparison - use == not =:",
        "code": "if password = \"secret\":\n    print(\"Access granted\")",
        "answer": "if password == \"secret\":\n    print(\"Access granted\")",
        "explanation": "== compares, = assigns. Use == in conditions.",
        "hints": ["Single = assigns", "Double == compares"]
      }
    ],
    "fix_and_optimize": [
      {
        "id": "py_conditions_opt_1",
        "prompt": "Optimize - check if value in range:",
        "code": "if x >= 0 and x <= 100:\n    print(\"Valid\")",
        "answer": "if 0 <= x <= 100:\n    print(\"Valid\")",
        "explanation": "Python supports chained comparisons.",
        "hints": ["Chain comparisons", "Cleaner and faster"]
      },
      {
        "id": "py_conditions_opt_2",
        "prompt": "Optimize - check multiple values:",
        "code": "if color == \"red\" or color == \"blue\" or color == \"green\":\n    print(\"Primary\")",
        "answer": "if color in [\"red\", \"blue\", \"green\"]:\n    print(\"Primary\")",
        "explanation": "Use 'in' with list for multiple value checks.",
        "hints": ["in operator checks membership", "Cleaner than many or's"]
      }
