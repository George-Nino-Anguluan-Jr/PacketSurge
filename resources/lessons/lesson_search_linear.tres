[resource]
script = ExtResource("1_l7yaq")
lesson_id = "search_linear"
title = "Linear Search"
category = "data_structures"
icon_text = "→"
prerequisites = Array[String](["sort_radix"])
visualization_scene = ExtResource("2_ln84h")
concept_text = "Linear Search checks every item one by one until it finds the target.

It's the simplest search — it works on ANY list (sorted or not).

How it works:
    arr = [5, 3, 8, 1], target = 8

    Check index 0: 5 ≠ 8 → keep going
    Check index 1: 3 ≠ 8 → keep going
    Check index 2: 8 == 8 → Found at index 2!

Time: O(n) — may need to check all n items
Space: O(1) — no extra memory needed

The downside: for a million items, you might check all million.
The upside: no sorting required, works on any data."
real_world_example = "Think of looking for a specific book on a shelf.
If the books aren't organized, you have to check each one until you find it.

    shelf = [\"Math\", \"Science\", \"History\", \"Art\"]
    target = \"History\"

    Check \"Math\" → not it
    Check \"Science\" → not it
    Check \"History\" → found! (index 2)

Linear search is the only option when data isn't sorted.
It's also useful for small lists where simplicity matters more than speed."
guided_example = "Let's search for the number 7 in [4, 2, 7, 1, 9].

Step 1 — Set up:
    arr = [4, 2, 7, 1, 9]
    target = 7

Step 2 — Loop through each index:
    i=0: arr[0]=4 ≠ 7 → continue
    i=1: arr[1]=2 ≠ 7 → continue
    i=2: arr[2]=7 == 7 → found at index 2!

Step 3 — Print result:
    print(\"Found at:\", 2)

    Output: Found at: 2

If the target wasn't in the array, we'd check all 5 items and conclude \"not found\"."
recap_text = "- Check each item one by one from start to end
- Works on any list — no sorting needed
- Time: O(n) — worst case checks all n items
- Space: O(1) — no extra memory
- Best when: list is small, or list is unsorted
- Simple and always correct — just not the fastest"
challenge_instruction = "Arrange the blocks to search for a target in an unsorted list and print its index."
challenge_blocks = Array[String](["arr = [9, 2, 7, 4, 1]", "target = 7", "for i in range(len(arr)):", "if arr[i] == target:", "print(i)", "if arr[i] > target:", "for i in arr:", "print(arr[i])"])
correct_sequence = Array[String](["arr = [9, 2, 7, 4, 1]", "target = 7", "for i in range(len(arr)):", "if arr[i] == target:", "print(i)"])
code_template = "arr = [5, 8, 2, 9, 1]
target = ___
for i in range(len(arr)):
    if arr[i] == target:
        print(i)"
challenge_code = "arr = [5, 8, 2, 9, 1]
target = 9
for i in range(len(arr)):
    if arr[i] == target:
        print(i)"
expected_output = "3"
challenge_hint = "Loop through each index with range(len(arr)). Check if arr[i] equals the target. Print the index when found."
practice_question = "When is Linear Search the best choice?"
practice_options = Array[String](["When the array is very large", "When the array is sorted", "When the array is small or unsorted", "When you need O(log n) speed"])
practice_correct_index = 2
practice_explanation = "Linear Search is best when the array is small (simplicity wins) or when the data is unsorted (Binary Search won't work). For large sorted arrays, Binary Search is much faster at O(log n)."

