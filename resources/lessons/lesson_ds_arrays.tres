[resource]
script = ExtResource("1_mo1o6")
lesson_id = "ds_arrays"
title = "Arrays"
category = "data_structures"
prerequisites = Array[String](["py_functions"])
visualization_scene = ExtResource("2_qsa84")
concept_text = "An array stores multiple items in a fixed-size sequence.
Each item has a numbered position called an index, starting at 0.

In Python, we use lists to work like arrays:
    scores = [0, 0, 0, 0]   # array with 4 slots

Access any item instantly by its index:
    print(scores[0])   # first item
    scores[2] = 95     # change the third item

Key speeds:
- Access by index: fast (O(1))
- Search without index: slow (O(n))
- Insert/delete in middle: slow (O(n))"
real_world_example = "Think of a parking lot with numbered spots.
Spot 3 is always the third spot from the start.
You can go straight to spot 3 without checking spots 1 and 2.

    parking = [\"\", \"\", \"\", \"\", \"\"]
    parking[0] = \"Car A\"
    parking[3] = \"Car B\"
    print(parking[0])   # Car A — instant!
    print(parking[3])   # Car B — instant!

Finding a specific car without knowing its spot:
    for car in parking:
        if car == \"Car B\":
            print(\"Found!\")   # must check each one"
guided_example = "Let's track daily temperatures.

Step 1 — Create an array of 7 slots (one per day):
    temps = [0, 0, 0, 0, 0, 0, 0]

Step 2 — Fill in temperatures:
    temps[0] = 72
    temps[1] = 75
    temps[2] = 68
    temps[3] = 70
    temps[4] = 73

Step 3 — Read Wednesday's temp (index 2):
    print(temps[2])   # 68 — O(1) instant access

Step 4 — Find the highest temp:
    highest = temps[0]
    for t in temps:
        if t > highest:
            highest = t
    print(highest)    # 75 — O(n) checks all

Step 5 — Update a value:
    temps[4] = 74
    print(temps)      # [72, 75, 68, 70, 74, 0, 0]"
recap_text = "- Arrays store items in a fixed sequence
- Index starts at 0
- Access by index is O(1) — instant
- Searching without index is O(n) — checks each item
- Inserting/deleting needs shifting — O(n)
- Great for: fixed-size data, fast position-based access"
challenge_instruction = "Arrange the blocks to create an array, change the first item to 99, and print it."
challenge_blocks = Array[String](["nums = [0, 0, 0]", "nums[0] = 99", "print(nums[0])", "nums = [0, 0, 0", "nums[0] == 99", "print(nums[1])"])
correct_sequence = Array[String](["nums = [0, 0, 0]", "nums[0] = 99", "print(nums[0])"])
challenge_hint = "Create with: nums = [0, 0, 0]. Assign with: nums[0] = 99. Print with: print(nums[0])."
code_template = "nums = [0, 0, 0]
nums[___] = 55
print(nums[1])"
challenge_code = "nums = [0, 0, 0]
nums[1] = 55
print(nums[1])"
expected_output = "55"
practice_question = "What is the index of the first item in an array?"
practice_options = Array[String](["1", "0", "-1", "It depends on the array"])
practice_correct_index = 1
practice_explanation = "Array indexes always start at 0. The first item is at index 0, the second at index 1, and so on. This is true in Python and most programming languages."

