nums[0] = 99
print(nums[0])"
expected_output = "99"
practice_question = "What is the index of the FIRST item in an array?"
practice_options = Array[String](["1", "0", "-1", "It depends on the array"])
practice_correct_index = 1
practice_explanation = "Array indexes always start at 0. The first item is at index 0, the second at index 1, and so on. This is true in Python and almost every programming language. It feels weird at first, but you'll get used to it."
