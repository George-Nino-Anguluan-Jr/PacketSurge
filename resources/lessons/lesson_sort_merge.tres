[resource]
script = ExtResource("1_ri56b")
lesson_id = "sort_merge"
title = "Merge Sort"
category = "data_structures"
icon_text = "⊕"
prerequisites = Array[String](["sort_quick"])
visualization_scene = ExtResource("2_mr84h")
concept_text = "Merge Sort is a divide-and-conquer algorithm.
It splits the array in half, recursively sorts each half, then merges the sorted halves together.

Unlike Quick Sort, Merge Sort always runs in O(n log n) — even in the worst case.

How it works:
    arr = [38, 27, 43, 3]
    Split → [38, 27] and [43, 3]
    Split → [38], [27] and [43], [3]
    Merge [38] + [27] → [27, 38]
    Merge [43] + [3]  → [3, 43]
    Merge [27, 38] + [3, 43] → [3, 27, 38, 43]

Time: O(n log n) always (best, average, worst)
Space: O(n) — needs extra memory for merging"
real_world_example = "Merge Sort is preferred when stability matters:
- Sorting linked lists (it's the best choice)
- External sorting of huge files (too big for memory)
- Git uses merge-based algorithms to combine code
- Database systems for reliable sorting

It's guaranteed O(n log n) and stable — equal elements keep their original order."
guided_example = "Let's trace Merge Sort on [38, 27, 43, 3].

Step 1 — Split array in half:
    [38, 27] and [43, 3]

Step 2 — Split each half:
    [38], [27] and [43], [3]

Step 3 — Merge [38] and [27]:
    27 < 38 → [27, 38]

Step 4 — Merge [43] and [3]:
    3 < 43 → [3, 43]

Step 5 — Merge [27, 38] and [3, 43]:
    3 < 27 → take 3
    27 < 43 → take 27
    38 < 43 → take 38
    take 43
    Result: [3, 27, 38, 43] ✓

The key is the merge step: compare the fronts of each sorted half and take the smaller one."
recap_text = "- Split array in half, sort each half, merge them back
- Always O(n log n) — guaranteed
- Space O(n) — needs extra array for merging
- Stable: equal elements keep original order
- Great for linked lists and huge datasets
- Trade-off: uses more memory than Quick Sort"
challenge_instruction = "Arrange the blocks to split an array in half and merge two sorted halves."
challenge_blocks = Array[String](["arr = [4, 2, 7, 1]", "mid = len(arr) // 2", "left = arr[:mid]", "right = arr[mid:]", "print(left, right)", "left = arr[0]", "right = arr[1]", "mid = len(arr)"])
correct_sequence = Array[String](["arr = [4, 2, 7, 1]", "mid = len(arr) // 2", "left = arr[:mid]", "right = arr[mid:]", "print(left, right)"])
code_template = "arr = [6, 3, 9, 1]
mid = len(arr) // ___
left = arr[:mid]
right = arr[mid:]
print(left, right)"
challenge_code = "arr = [6, 3, 9, 1]
mid = len(arr) // 2
left = arr[:mid]
right = arr[mid:]
print(left, right)"
expected_output = "[6, 3] [9, 1]"
challenge_hint = "Find the middle index by dividing the array length by 2 (mid = len(arr) // 2). Slice from the start up to mid for the left half. Slice from mid to the end for the right half. Print both halves to see the split."
practice_question = "What is the worst-case time complexity of Merge Sort?"
practice_options = Array[String](["O(n²)", "O(n)", "O(n log n)", "O(log n)"])
practice_correct_index = 2
practice_explanation = "Merge Sort always runs in O(n log n) regardless of input. It always divides the array in half (log n levels) and does O(n) merge work per level — unlike Quick Sort which can degrade to O(n²)."
