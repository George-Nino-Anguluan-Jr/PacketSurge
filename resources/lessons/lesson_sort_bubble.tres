[resource]
script = ExtResource("1_csds4")
lesson_id = "sort_bubble"
title = "Bubble Sort"
category = "data_structures"
icon_text = "↑↑"
prerequisites = Array[String](["ds_linked_lists"])
visualization_scene = ExtResource("2_10maa")
concept_text = "Bubble Sort steps through a list, compares adjacent items, and swaps them if they're in the wrong order.

Larger values \"bubble up\" to the end like bubbles in water.

How it works:
    arr = [5, 3, 8, 1]
    Step 1: 5 > 3? → swap → [3, 5, 8, 1]
    Step 2: 5 > 8? → no swap
    Step 3: 8 > 1? → swap → [3, 5, 1, 8]
    ✓ 8 bubbled to the end

Time: O(n²) average, O(n) best (already sorted)
Space: O(1) — sorts in place"
real_world_example = "Imagine sorting a row of students by height.
Walk down the line, compare two at a time.
If the left is taller, swap them.
Keep walking until no more swaps are needed.

    heights = [165, 150, 172, 148]

    Pass 1: compare and swap
    [150, 165, 148, 172]  ← 172 bubbled to end

    Pass 2:
    [150, 148, 165, 172]

    Pass 3:
    [148, 150, 165, 172]  ← sorted!

Each pass guarantees the next largest value reaches its correct spot."
guided_example = "Let's trace Bubble Sort on [64, 34, 25, 12].

Step 1 — Pass 1 (compare pairs 0-1, 1-2, 2-3):
    64 > 34? swap → [34, 64, 25, 12]
    64 > 25? swap → [34, 25, 64, 12]
    64 > 12? swap → [34, 25, 12, 64]
    ✓ 64 is in correct position

Step 2 — Pass 2 (compare pairs 0-1, 1-2):
    34 > 25? swap → [25, 34, 12, 64]
    34 > 12? swap → [25, 12, 34, 64]
    ✓ 34 is in correct position

Step 3 — Pass 3 (compare pair 0-1):
    25 > 12? swap → [12, 25, 34, 64]
    ✓ Sorted!

After each pass, the next largest value is locked in place at the end."
recap_text = "- Compare adjacent pairs, swap if wrong order
- Largest values bubble to the end each pass
- Time: O(n²) average/worst, O(n) best (already sorted)
- Space: O(1) — no extra memory
- Simple but slow for large datasets
- Good for: small arrays, nearly sorted data, learning"
challenge_instruction = "Arrange the blocks for one pass of Bubble Sort."
challenge_blocks = Array[String](["arr = [7, 3, 9, 2]", "for j in range(len(arr) - 1):", "if arr[j] > arr[j + 1]:", "arr[j], arr[j + 1] = arr[j + 1], arr[j]", "print(arr)", "if arr[j] < arr[j + 1]:", "for j in range(len(arr)):", "arr[j] = arr[j + 1]"])
correct_sequence = Array[String](["arr = [7, 3, 9, 2]", "for j in range(len(arr) - 1):", "if arr[j] > arr[j + 1]:", "arr[j], arr[j + 1] = arr[j + 1], arr[j]", "print(arr)"])
code_template = "arr = [7, 3, 9, 2]
for j in range(len(arr) - 1):
    if arr[j] > arr[j + 1]:
        temp = arr[j]
        arr[j] = arr[j + 1]
        arr[j + 1] = ___
print(arr)"
challenge_code = "arr = [7, 3, 9, 2]
for j in range(len(arr) - 1):
    if arr[j] > arr[j + 1]:
        temp = arr[j]
        arr[j] = arr[j + 1]
        arr[j + 1] = temp
print(arr)"
expected_output = "[3, 7, 2, 9]"
challenge_hint = "Start by setting up the array. Then loop through each adjacent pair (j and j+1) from the beginning up to the second-to-last element. Compare arr[j] with arr[j+1] — if the left is bigger, swap them by saving arr[j] in a temporary variable first. Finally print the result."
practice_question = "What happens in one pass of Bubble Sort?"
practice_options = Array[String](["The smallest value moves to the start", "The largest value bubbles to the end", "The array is fully sorted", "The array is reversed"])
practice_correct_index = 1
practice_explanation = "In each pass, the largest unsorted value \"bubbles up\" to its correct position at the end. You need n-1 passes to fully sort n items."

