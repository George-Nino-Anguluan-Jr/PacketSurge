[resource]
script = ExtResource("1_51rxj")
lesson_id = "py_functions"
title = "Functions"
category = "python"
icon_text = "f()"
prerequisites = Array[String](["py_conditions"])
visualization_scene = ExtResource("2_384g4")
concept_text = "A function is a reusable block of code.
Define it once with def, then call it by name whenever needed.

    def function_name(parameters):
        code to run
        return result

Example:
    def greet(name):
        return \"Hi, \" + name

    print(greet(\"Luna\"))   # Hi, Luna
    print(greet(\"Max\"))    # Hi, Max

Benefits:
- Write once, use many times
- Keep code organized
- Easier to fix and update"
real_world_example = "Think of a vending machine.
You select a button (input), the machine does its work, and gives you a snack (output).

    def vending(choice):
        if choice == 1:
            return \"Chips\"
        elif choice == 2:
            return \"Chocolate\"
        else:
            return \"Water\"

    print(vending(1))   # Chips
    print(vending(3))   # Water"
guided_example = "Let's build a function that doubles a number.

Step 1 — Define the function:
    def double(n):
        return n * 2

Step 2 — Call it with different values:
    print(double(4))   # 8
    print(double(10))  # 20
    print(double(0))   # 0

Step 3 — Use it in a program:
    score = 50
    bonus = double(score)
    print(\"Total:\", bonus)   # Total: 100

The function works with any number you give it."
recap_text = "- def creates a function
- Functions take inputs called parameters
- return sends a result back to the caller
- Call a function with name(arguments)
- Functions help avoid repeating code
- Code inside a function must be indented"
challenge_instruction = "Arrange the blocks to define a function that multiplies two numbers and call it."
challenge_blocks = Array[String](["def multiply(a, b):", "    return a * b", "print(multiply(4, 5))", "print multiply(4, 5)", "def multiply(a, b)", "    return a + b"])
correct_sequence = Array[String](["def multiply(a, b):", "    return a * b", "print(multiply(4, 5))"])
code_template = "def multiply(a, b):
    return a ___ b
result = multiply(___, ___)
print(result)"
challenge_code = "def multiply(a, b):
    return a * b
result = multiply(3, 7)
print(result)"
expected_output = "21"
challenge_hint = "Start with def function_name(parameters): then indent the body. Use return to send the result. Call it with print(function_name(values))."
practice_question = "What is the output of this code?    def square(x):    return x * x    print(square(5))"
practice_options = Array[String](["10", "25", "5", "square(5)"])
practice_correct_index = 1
practice_explanation = "The function square(x) returns x * x. When called with square(5), it computes 5 * 5 = 25."

