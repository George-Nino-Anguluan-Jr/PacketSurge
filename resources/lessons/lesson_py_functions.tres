print(add(3, 4))"
expected_output = "7"
practice_question = "What does this print?    def square(x):    return x * x    print(square(5))"
practice_options = Array[String](["10", "25", "5", "square(5)"])
practice_correct_index = 1
practice_explanation = "square(5) means: call the function with x = 5. Inside, return x * x means return 5 * 5 = 25. So print(square(5)) displays 25. The function name is just a label — what gets printed is the return value."
