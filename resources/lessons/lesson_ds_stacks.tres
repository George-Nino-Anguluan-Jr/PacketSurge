[resource]
script = ExtResource("1_ureiw")
lesson_id = "ds_stacks"
title = "Stacks"
category = "data_structures"
icon_text = "↑↓"
prerequisites = Array[String](["ds_arrays"])
visualization_scene = ExtResource("2_t55l4")
concept_text = "A stack follows Last In First Out (LIFO).
The last item added is the first item removed.

Think of a stack of plates — you add to the top and remove from the top.

Two main operations:
    push  — add an item to the top
    pop   — remove the top item

In Python:
    stack = []
    stack.append(\"A\")     # push A
    stack.append(\"B\")     # push B
    print(stack.pop())    # pop → B (last in, first out)
    print(stack.pop())    # pop → A

All operations are fast (O(1))."
real_world_example = "Think of a browser's back button.
Each page you visit gets pushed onto a stack.
Clicking Back pops the most recent page.

    history = []
    history.append(\"Home\")      # push
    history.append(\"About\")     # push
    history.append(\"Contact\")   # push

    print(history.pop())        # → Contact
    print(history.pop())        # → About
    print(history.pop())        # → Home

The most recent page is always returned first."
guided_example = "Let's use a stack to track game actions.

Step 1 — Create empty stack:
    actions = []

Step 2 — Player performs actions:
    actions.append(\"jump\")
    actions.append(\"shoot\")
    actions.append(\"dodge\")

Step 3 — Look at the top (peek):
    print(actions[-1])      # dodge

Step 4 — Undo the last action:
    last = actions.pop()
    print(\"Undid:\", last)   # Undid: dodge
    print(actions)           # [\"jump\", \"shoot\"]

Step 5 — Undo again:
    last = actions.pop()
    print(\"Undid:\", last)   # Undid: shoot"
recap_text = "- Stacks use LIFO: Last In, First Out
- push (= append) adds to the top — O(1)
- pop removes from the top — O(1)
- peek (= [-1]) views the top — O(1)
- In Python: use a list with append() and pop()
- Real uses: undo systems, browser history, call stack"
challenge_instruction = "Arrange the blocks to push three items onto a stack and pop and print the last one."
challenge_blocks = Array[String](["stack = []", "stack.append(\"x\")", "stack.append(\"y\")", "stack.append(\"z\")", "print(stack.pop())", "stack.push(\"x\")", "print(stack[0])"])
correct_sequence = Array[String](["stack = []", "stack.append(\"x\")", "stack.append(\"y\")", "stack.append(\"z\")", "print(stack.pop())"])
code_template = "stack = []
stack.append(\"___\")
stack.append(\"middle\")
stack.append(\"last\")
print(stack.pop())"
challenge_code = "stack = []
stack.append(\"first\")
stack.append(\"middle\")
stack.append(\"last\")
print(stack.pop())"
expected_output = "last"
challenge_hint = "Use a list as a stack. append() adds to the top. pop() removes and returns the top item."
practice_question = "What will this code print?    s = []    s.append(1)    s.append(2)    print(s.pop())"
practice_options = Array[String](["1", "2", "[1, 2]", "Nothing"])
practice_correct_index = 1
practice_explanation = "Items are pushed in order: 1 then 2. The stack is [1, 2] with 2 on top. pop() removes and returns the top item, so it prints 2."
