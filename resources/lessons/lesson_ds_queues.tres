practice_question = "What is the difference between a stack and a queue?"
practice_options = Array[String](["Stack is FIFO, queue is LIFO", "Stack is LIFO, queue is FIFO", "They are exactly the same", "Stack has no pop operation"])
practice_correct_index = 1
practice_explanation = "Stack is LIFO (Last In First Out) — the most recent is removed first. Queue is FIFO (First In First Out) — the oldest is removed first. They serve opposite purposes. Use a stack for undo/back, use a queue for lines and task order."
