[resource]
script = ExtResource("1_eftlh")
lesson_id = "ds_queues"
title = "Queues"
category = "data_structures"
icon_text = "→"
prerequisites = Array[String](["ds_stacks"])
visualization_scene = ExtResource("2_m1hvm")
concept_text = "A queue follows First In First Out (FIFO).
The first item added is the first item removed.

Think of a line at a store — the first person in line gets served first.

Two main operations:
    enqueue — add to the back
    dequeue — remove from the front

In Python, use deque for efficient queues:
    from collections import deque
    q = deque()
    q.append(\"A\")         # enqueue A
    q.append(\"B\")         # enqueue B
    print(q.popleft())    # dequeue → A (first in, first out)
    print(q.popleft())    # dequeue → B

Both operations are fast (O(1))."
real_world_example = "Think of a ticket counter at a movie theater.
The first person in line gets the first ticket.

    from collections import deque
    line = deque()
    line.append(\"Alice\")    # joins the line
    line.append(\"Bob\")      # joins behind Alice
    line.append(\"Charlie\")  # joins behind Bob

    # Serve customers in order
    print(line.popleft())   # Alice — first served
    print(line.popleft())   # Bob
    print(line.popleft())   # Charlie

First to arrive = first to be served. That's FIFO."
guided_example = "Let's build a task queue.

Step 1 — Import and create:
    from collections import deque
    tasks = deque()

Step 2 — Add tasks (enqueue):
    tasks.append(\"Task 1: Setup\")
    tasks.append(\"Task 2: Build\")
    tasks.append(\"Task 3: Test\")

Step 3 — Process tasks in order (dequeue):
    current = tasks.popleft()
    print(\"Doing:\", current)   # Doing: Task 1: Setup

Step 4 — Check remaining:
    print(len(tasks))           # 2

Step 5 — Process the rest:
    while len(tasks) > 0:
        print(\"Doing:\", tasks.popleft())
    # Doing: Task 2: Build
    # Doing: Task 3: Test"
recap_text = "- Queues use FIFO: First In, First Out
- enqueue (= append) adds to the back — O(1)
- dequeue (= popleft) removes from the front — O(1)
- Use collections.deque for efficient queues
- Stacks = LIFO, Queues = FIFO
- Real uses: print queues, customer lines, network packets"
challenge_instruction = "Arrange the blocks to create a queue, add two items, and remove the first one."
challenge_blocks = Array[String](["from collections import deque", "q = deque()", "q.append(\"a\")", "q.append(\"b\")", "print(q.popleft())", "print(q.pop())", "q = []", "q.appendleft(\"a\")"])
correct_sequence = Array[String](["from collections import deque", "q = deque()", "q.append(\"a\")", "q.append(\"b\")", "print(q.popleft())"])
