challenge_code = "from collections import deque
q = deque()
q.append(\"first\")
q.append(\"second\")
print(q.popleft())"
expected_output = "first"
challenge_hint = "Import deque, create q = deque(). Use append() to add items. Use popleft() to remove the first item."
practice_question = "What is the difference between a stack and a queue?"
practice_options = Array[String](["Stack uses FIFO, Queue uses LIFO", "Stack uses LIFO, Queue uses FIFO", "They are exactly the same", "Stack has no pop operation"])
practice_correct_index = 1
practice_explanation = "Stack follows LIFO (Last In First Out) — the last item added is removed first. Queue follows FIFO (First In First Out) — the first item added is removed first. They serve opposite use cases."
