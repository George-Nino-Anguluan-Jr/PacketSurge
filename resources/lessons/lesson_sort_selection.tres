practice_question = "How many swaps does Selection Sort make for an array of 5 elements (in the worst case)?"
practice_options = Array[String](["Up to 10 swaps", "Exactly 5 swaps", "At most 4 swaps", "Depends on the data, could be 0"])
practice_correct_index = 2
practice_explanation = "Selection Sort makes at most n-1 swaps for n elements. For 5 elements, that's 4 swaps maximum — one per pass. This is LESS than Bubble Sort, which can swap many times per pass. Fewer swaps = potentially faster if swaps are expensive."
