[resource]
script = ExtResource("1_6cnu5")
lesson_id = "py_lists"
title = "Lists"
category = "python"
prerequisites = Array[String](["py_variables"])
visualization_scene = ExtResource("2_ontg8")
concept_text = "A list stores multiple items in a single variable.
Items are ordered and each has a position number (index).

Create a list with square brackets:
    colors = [\"red\", \"green\", \"blue\"]

Indexes start at 0:
    colors[0] → \"red\"
    colors[1] → \"green\"
    colors[2] → \"blue\"

Lists are flexible — you can add, remove, or change items."
real_world_example = "Think of a shopping list on your fridge.
You write items in order, cross them off, and add new ones.

    shopping = [\"milk\", \"eggs\", \"bread\"]
    print(shopping[0])  # milk

    shopping.append(\"butter\")
    print(shopping)     # [\"milk\", \"eggs\", \"bread\", \"butter\"]

    shopping.remove(\"eggs\")
    print(shopping)     # [\"milk\", \"bread\", \"butter\"]"
guided_example = "Let's manage a game inventory.

Step 1 — Create the inventory:
    inventory = [\"sword\", \"shield\", \"potion\"]

Step 2 — Check the first item:
    print(inventory[0])   # sword

Step 3 — Add a new item:
    inventory.append(\"ring\")
    print(inventory)      # [\"sword\", \"shield\", \"potion\", \"ring\"]

Step 4 — Replace an item:
    inventory[1] = \"armor\"
    print(inventory[1])   # armor

Step 5 — Count items:
    print(len(inventory)) # 4"
recap_text = "- Lists hold multiple values in one variable
- Use [] brackets: items = [\"a\", \"b\", \"c\"]
- Index starts at 0: items[0] is the first item
- append() adds to the end
- remove() deletes an item
- len() counts the items
- You can change any item by assigning to its index"
challenge_instruction = "Arrange the blocks to create a list of power-ups and print the second one."
challenge_blocks = Array[String](["powerups = [\"mushroom\", \"star\", \"flower\"]", "print(powerups[1])", "powerups = \"mushroom\", \"star\", \"flower\"", "print(powerups[2])", "list powerups = [\"mushroom\", \"star\", \"flower\"]"])
correct_sequence = Array[String](["powerups = [\"mushroom\", \"star\", \"flower\"]", "print(powerups[1])"])
code_template = "items = [\"___\", \"bow\", \"arrow\"]\nprint(items[0])"
challenge_code = "items = [\"sword\", \"bow\", \"arrow\"]\nprint(items[0])"
expected_output = "sword"
challenge_hint = "Use square brackets [ ] for lists. Index 1 gives the second item. Remember: lists start counting at 0!"
practice_question = "What does len() tell you about a list?"
practice_options = Array[String](["The number of items in the list", "The last item in the list", "The first item in the list", "The total size of the list in memory"])
practice_correct_index = 0
practice_explanation = "len() returns the number of items (length) of the list. For example, len([10, 20, 30]) returns 3."

