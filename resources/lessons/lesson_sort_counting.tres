[resource]
script = ExtResource("1_0x24s")
lesson_id = "sort_counting"
title = "Counting Sort"
category = "data_structures"
icon_text = "#"
prerequisites = Array[String](["sort_merge"])
visualization_scene = ExtResource("2_ct84h")
concept_text = "Counting Sort is different from other sorts — it doesn't compare elements.
Instead, it counts how many times each value appears, then uses those counts to place elements in order.

This only works for numbers with a small range (like scores 0-100).

How it works:
    arr = [4, 2, 2, 8, 3, 3, 1]

    Step 1: Count occurrences
    count[1]=1, count[2]=2, count[3]=2, count[4]=1, count[8]=1

    Step 2: Build result from counts
    [1, 2, 2, 3, 3, 4, 8]

Time: O(n + k) where k is the range of values
Space: O(k) — needs a count array"
real_world_example = "Counting Sort is used when values have a small range:
- Sorting exam scores (0-100 range, thousands of students)
- Sorting age groups in census data
- Sorting pixel colors in images (0-255)
- As a helper inside Radix Sort

It's incredibly fast when the value range is small — faster than any comparison sort."
guided_example = "Let's trace Counting Sort on [4, 2, 2, 8, 3, 3, 1].

Step 1 — Find the maximum value: max = 8

Step 2 — Create a count array of size 9 (0 through 8):
    count = [0, 0, 0, 0, 0, 0, 0, 0, 0]

Step 3 — Count each value:
    4 → count[4] = 1
    2 → count[2] = 1, then count[2] = 2
    8 → count[8] = 1
    3 → count[3] = 1, then count[3] = 2
    1 → count[1] = 1

Step 4 — Build result:
    1 appears 1x → [1]
    2 appears 2x → [1, 2, 2]
    3 appears 2x → [1, 2, 2, 3, 3]
    4 appears 1x → [1, 2, 2, 3, 3, 4]
    8 appears 1x → [1, 2, 2, 3, 3, 4, 8] ✓ Sorted!"
recap_text = "- Count occurrences of each value, then rebuild sorted array
- No comparisons — uses counting instead
- Time: O(n + k) where k is the value range
- Space: O(k) for the count array
- Only works for integers with a small range
- Much faster than O(n log n) sorts when k is small"
challenge_instruction = "Arrange the blocks to count occurrences of each value and build the sorted result."
challenge_blocks = Array[String](["arr = [3, 1, 2, 1]", "count = [0, 0, 0, 0]", "for num in arr:", "count[num] += 1", "print(count)", "count[num] -= 1", "for num in range(len(arr)):"])
correct_sequence = Array[String](["arr = [3, 1, 2, 1]", "count = [0, 0, 0, 0]", "for num in arr:", "count[num] += 1", "print(count)"])
code_template = "arr = [2, 0, 1, 2]
max_val = 2
count = [0, 0, 0]
for num in arr:
    count[num] += ___
print(count)"
challenge_code = "arr = [2, 0, 1, 2]
max_val = 2
count = [0, 0, 0]
for num in arr:
    count[num] += 1
print(count)"
expected_output = "[1, 1, 2]"
challenge_hint = "Create a count array with enough slots for all possible values (0 to max_val). Then loop through the input array — for each number, increment its matching slot in the count array by 1. Print the count array to see the tallies."
practice_question = "What does the 'k' in O(n + k) represent?"
practice_options = Array[String](["The number of elements", "The range of possible values", "The number of passes", "The size of the count array"])
practice_correct_index = 1
practice_explanation = "In O(n + k), n is the number of elements and k is the range of possible values (max - min + 1). Counting Sort is fast when k is small — it becomes slow if the range is huge (like 0 to 1 million)."
