[resource]
script = ExtResource("1_h46rf")
lesson_id = "sort_insertion"
title = "Insertion Sort"
category = "data_structures"
icon_text = "←↑"
prerequisites = Array[String](["sort_selection"])
visualization_scene = ExtResource("2_h3kw3")
concept_text = "Insertion Sort builds the sorted array one item at a time.
It takes each element and inserts it into
its correct position among the already-sorted elements.

Like sorting playing cards in your hand —
you pick up one card at a time and slide it
into the right position.

In Python:
    def insertion_sort(arr):
        for i in range(1, len(arr)):
            key = arr[i]
            j = i - 1
            while j >= 0 and arr[j] > key:
                arr[j + 1] = arr[j]
                j -= 1
            arr[j + 1] = key
        return arr

Time Complexity:
    Best:    O(n)   — already sorted
    Average: O(n²)
    Worst:   O(n²)  — reverse sorted

Space Complexity: O(1) — sorts in place

Key advantage: Excellent for nearly sorted data."
real_world_example = "Think of how you sort cards dealt to you one at a time.

You receive: 7, then 3, then 9, then 1, then 5

Card 7:  [7]              ← first card, nothing to compare
Card 3:  3 < 7 → [3, 7]  ← insert before 7
Card 9:  9 > 7 → [3, 7, 9] ← insert at end
Card 1:  1 < everything → [1, 3, 7, 9] ← insert at start
Card 5:  3 < 5 < 7 → [1, 3, 5, 7, 9] ← insert in middle

Each new card is inserted into its correct position
among the cards you already hold — exactly like Insertion Sort."
guided_example = "Let's trace Insertion Sort step by step.

Initial: [12, 11, 13, 5, 6]

Pass 1 — key = 11 (index 1):
    11 < 12 → shift 12 right
    Insert 11 at index 0
    Result: [11, 12, 13, 5, 6]

Pass 2 — key = 13 (index 2):
    13 > 12 → no shift needed
    13 stays in place
    Result: [11, 12, 13, 5, 6]

Pass 3 — key = 5 (index 3):
    5 < 13 → shift 13 right
    5 < 12 → shift 12 right
    5 < 11 → shift 11 right
    Insert 5 at index 0
    Result: [5, 11, 12, 13, 6]

Pass 4 — key = 6 (index 4):
    6 < 13 → shift
    6 < 12 → shift
    6 < 11 → shift
    6 > 5 → stop
    Insert 6 at index 1
    Result: [5, 6, 11, 12, 13] ✓ Sorted!"
recap_text = "- Insertion Sort builds sorted array one element at a time
- Each element is inserted into correct position
- Best case O(n) — when data is nearly sorted
- Average and worst case O(n²)
- Space complexity O(1) — in place
- Stable sort — equal elements keep their original order
- Best of the three basic sorts for nearly sorted data
- Used in practice for small arrays (< 10-20 elements)
- Hybrid algorithms like Timsort use Insertion Sort internally"
challenge_instruction = "Arrange the blocks to perform one step ofInsertion Sort — insert the second elementinto its correct position."
challenge_blocks = Array[String](["arr = [12, 11, 13, 5]", "key = arr[1]", "j = 0", "while j >= 0 and arr[j] > key:", " arr[j + 1] = arr[j]", "j -= 1", "arr[j + 1] = key", "print(arr)", "key = arr[0]", "j = 1"])
correct_sequence = Array[String](["arr = [12, 11, 13, 5]", "key = arr[1]", "j = 0", "while j >= 0 and arr[j] > key:", "arr[j + 1] = arr[j]", "j -= 1", "arr[j + 1] = key", "print(arr)"])
challenge_hint = "key holds the element being inserted.j starts one position before key.Shift elements right while they are greater than key.Place key at j + 1 after the while loop ends."
practice_question = "Which scenario gives Insertion Sort its best case O(n) performance?"
practice_options = Array[String](["Array is in reverse sorted order", "Array has all duplicate elements", "Array is already sorted", "Array has random elements"])
practice_correct_index = 2
practice_explanation = "When the array is already sorted Insertion Sort runs in O(n).Each element is compared once to the element before it.No shifting is needed — the while loop never executes.This makes it ideal for nearly sorted data."
