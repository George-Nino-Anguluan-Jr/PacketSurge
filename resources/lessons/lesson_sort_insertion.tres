[resource]
script = ExtResource("1_h46rf")
lesson_id = "sort_insertion"
title = "Insertion Sort"
category = "data_structures"
icon_text = "←↑"
prerequisites = Array[String](["sort_selection"])
concept_text = "Insertion Sort builds a sorted list one item at a time.
It takes each new element and inserts it into its correct position among already-sorted elements.

Like sorting playing cards — pick up one card and slide it into the right spot.

How it works:
    arr = [12, 11, 13, 5]
    Take 11 → compare with 12 → 11 < 12 → insert before 12
    [11, 12, 13, 5]
    Take 13 → compare with 12 → 13 > 12 → stays
    [11, 12, 13, 5]
    Take 5 → compare with 13, 12, 11 → slide and insert at front
    [5, 11, 12, 13]

Time: O(n²) average/worst, O(n) best (nearly sorted)
Space: O(1) — sorts in place"
real_world_example = "Think of sorting cards dealt to you one at a time.

    Dealt: 7, then 3, then 9, then 1, then 5

    Card 7:  [7]
    Card 3:  3 < 7 → [3, 7]
    Card 9:  9 > 7 → [3, 7, 9]
    Card 1:  1 < everything → [1, 3, 7, 9]
    Card 5:  between 3 and 7 → [1, 3, 5, 7, 9]

Each new card is inserted into its correct position among the cards you already hold."
guided_example = "Let's trace Insertion Sort on [12, 11, 13, 5, 6].

Step 1 — key = 11 (index 1):
    11 < 12 → shift 12 right
    Insert 11 at index 0
    [11, 12, 13, 5, 6]

Step 2 — key = 13 (index 2):
    13 > 12 → no shift needed
    [11, 12, 13, 5, 6]

Step 3 — key = 5 (index 3):
    5 < 13 → shift 13 right
    5 < 12 → shift 12 right
    5 < 11 → shift 11 right
    Insert 5 at index 0
    [5, 11, 12, 13, 6]

Step 4 — key = 6 (index 4):
    6 < 13, 6 < 12, 6 < 11 → shift all three
    6 > 5 → stop
    Insert 6 at index 1
    [5, 6, 11, 12, 13] ✓ Sorted!"
recap_text = "- Build sorted list one element at a time
- Each element is inserted into its correct position
- Best case O(n) — when data is nearly sorted
- Average/worst case O(n²)
- Space O(1) — in place
- Stable: equal elements keep their original order
- Best of the basic sorts for nearly sorted data"
challenge_instruction = "Arrange the blocks to insert the second element into its correct position."
challenge_blocks = Array[String](["arr = [8, 3, 6, 2]", "key = arr[1]", "j = 0", "while j >= 0 and arr[j] > key:", "arr[j + 1] = arr[j]", "j -= 1", "arr[j + 1] = key", "print(arr)", "key = arr[0]", "j = 1"])
correct_sequence = Array[String](["arr = [8, 3, 6, 2]", "key = arr[1]", "j = 0", "while j >= 0 and arr[j] > key:", "arr[j + 1] = arr[j]", "j -= 1", "arr[j + 1] = key", "print(arr)"])
code_template = "arr = [8, 3, 6, 2]
key = arr[1]
j = 0
while j >= 0 and arr[j] > key:
    arr[j + 1] = arr[j]
    j -= 1
arr[j + 1] = ___
print(arr)"
challenge_code = "arr = [8, 3, 6, 2]
key = arr[1]
j = 0
while j >= 0 and arr[j] > key:
    arr[j + 1] = arr[j]
    j -= 1
arr[j + 1] = key
print(arr)"
expected_output = "[3, 8, 6, 2]"
challenge_hint = "Save the element at index 1 as your key. Start j at 0 (one position behind key). While j is at least 0 AND arr[j] is larger than key, shift arr[j] one spot to the right and decrease j. After the loop, place key into the empty spot at j + 1."
practice_question = "When does Insertion Sort perform best (O(n))?"
practice_options = Array[String](["Array is reverse sorted", "Array is already sorted", "Array has all duplicates", "Array has random elements"])
practice_correct_index = 1
practice_explanation = "When the array is already sorted, Insertion Sort runs in O(n). Each element only needs one comparison — no shifting needed since every element is already in place."
