practice_question = "What is the key REQUIREMENT for Binary Search to work?"
practice_options = Array[String](["Array must have an even number of elements", "Array must be sorted", "Array must contain only integers", "Array must have no duplicates"])
practice_correct_index = 1
practice_explanation = "Binary Search REQUIRES a sorted array. The whole algorithm depends on the ability to know which half of the array contains the target by comparing to the middle element. Without sorting, you'd have no way to know which half to discard. If your data isn't sorted, you must either sort it first (one-time cost) or use Linear Search."
