[resource]
script = ExtResource("1_xk5ya")
lesson_id = "search_binary"
title = "Binary Search"
category = "data_structures"
icon_text = "½"
prerequisites = Array[String](["search_linear"])
concept_text = "Binary Search is a fast search that works ONLY on sorted arrays.
It repeatedly cuts the search range in half by comparing the target to the middle element.

How it works on [1, 3, 5, 7, 9, 11, 13], target=7:

    left=0, right=6 → mid=3 → arr[3]=7 == target! Found!

Searching 1 billion items takes only ~30 steps (O(log n)).

How it works on [1, 3, 5, 7, 9, 11, 13], target=6:

    left=0, right=6 → mid=3 → arr[3]=7 > 6 → right=2
    left=0, right=2 → mid=1 → arr[1]=3 < 6 → left=2
    left=2, right=2 → mid=2 → arr[2]=5 < 6 → left=3
    left=3 > right=2 → not found! return -1

Time: O(log n) — extremely fast
Space: O(1) — iterative version needs no extra memory"
real_world_example = "Binary Search is everywhere in computing:
- Dictionary lookups (alphabetical = sorted)
- Git bisect finds which commit introduced a bug
- Database indexes find records instantly
- Autocomplete searches sorted word lists
- Python's bisect module implements Binary Search

Any time data is sorted, Binary Search is the go-to method."
guided_example = "Let's search for target=23 in [2, 5, 8, 12, 16, 23, 38, 56].

Step 1 — Set pointers:
    left = 0 (index of first element)
    right = 7 (index of last element)

Step 2 — Calculate mid:
    mid = (0 + 7) // 2 = 3
    arr[3] = 12

Step 3 — Compare:
    12 < 23 → target is in right half
    left = mid + 1 = 4

Step 4 — New mid:
    mid = (4 + 7) // 2 = 5
    arr[5] = 23 == target! Found at index 5!

Only 3 steps to find 23 in an 8-element array.
With linear search, it would take 6 steps."
recap_text = "- Works ONLY on sorted arrays
- Repeatedly halves the search range
- Time: O(log n) — extremely fast
- Space: O(1) — no extra memory
- 1 billion items → ~30 steps
- Trade-off: array must be sorted first
- Much faster than Linear Search for large data"
challenge_instruction = "Arrange the blocks to perform Binary Search on a sorted array."
challenge_blocks = Array[String](["arr = [1, 3, 5, 7, 9]", "target = 7", "left = 0", "right = len(arr) - 1", "while left <= right:", "mid = (left + right) // 2", "if arr[mid] == target: print(mid); left = right + 1", "elif arr[mid] < target: left = mid + 1", "else: right = mid - 1", "if arr[mid] > target:", "left = 0; right = 0"])
correct_sequence = Array[String](["arr = [1, 3, 5, 7, 9]", "target = 7", "left = 0", "right = len(arr) - 1", "while left <= right:", "mid = (left + right) // 2", "if arr[mid] == target: print(mid); left = right + 1", "elif arr[mid] < target: left = mid + 1", "else: right = mid - 1"])
code_template = "arr = [1, 3, 5, 7, 9]
target = ___
left = 0
right = len(arr) - 1
while left <= right:
    mid = (left + right) // 2
    if arr[mid] == target:
        print(mid)
        left = right + 1
    elif arr[mid] < target:
        left = mid + 1
    else:
        right = mid - 1"
challenge_code = "arr = [1, 3, 5, 7, 9]
target = 7
left = 0
right = len(arr) - 1
while left <= right:
    mid = (left + right) // 2
    if arr[mid] == target:
        print(mid)
        left = right + 1
    elif arr[mid] < target:
        left = mid + 1
    else:
        right = mid - 1"
expected_output = "3"
challenge_hint = "Set left=0, right=len(arr)-1. Loop while left <= right. Calculate mid = (left+right)//2. If found, print and exit. If target > arr[mid], search right half. If target < arr[mid], search left half."
practice_question = "What is the key requirement for Binary Search to work?"
practice_options = Array[String](["Array must have an even number of elements", "Array must be sorted", "Array must contain only integers", "Array must have no duplicates"])
practice_correct_index = 1
practice_explanation = "Binary Search REQUIRES a sorted array. Without sorting, dividing the search space in half doesn't work — you have no way to know which half contains the target."
