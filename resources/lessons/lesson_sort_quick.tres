practice_question = "What is the average time complexity of Quick Sort?"
practice_options = Array[String](["O(n²)", "O(n log n)", "O(log n)", "O(n)"])
practice_correct_index = 1
practice_explanation = "Quick Sort averages O(n log n). At each level, we do O(n) work to partition the array. We have about log n levels because the array gets cut roughly in half each time. Multiply: O(n) × O(log n) = O(n log n). The worst case O(n²) happens with bad pivot choices (e.g. always picking the smallest or largest element)."
