script = ExtResource("1_xgqti")
lesson_id = "sort_quick"
title = "Quick Sort"
category = "data_structures"
icon_text = "⚡"
prerequisites = Array[String](["sort_insertion"])
concept_text = "Quick Sort picks a pivot element, then partitions the array so smaller elements go left and larger go right. Each half is then sorted the same way (recursively).

How it works:
    arr = [3, 6, 8, 10, 1, 2, 1]
    Pick pivot (middle): 10
    Left (smaller):  [3, 6, 8, 1, 2, 1]
    Middle (equal):  [10]
    Right (larger):  []
    Recursively sort left → combine → [1, 1, 2, 3, 6, 8, 10]

Time: O(n log n) average, O(n²) worst
Space: O(log n) — recursive calls"
real_world_example = "Quick Sort is widely used in practice:
- Python's built-in sort() uses Timsort (hybrid with Insertion Sort)
- Database engines use Quick Sort variants
- Video game leaderboards sort scores
- Operating systems sort file directories

It's popular because it's fast in practice and works well with CPU caching."
guided_example = "Let's trace Quick Sort on [3, 6, 8, 10, 1, 2, 1].

Step 1 — Pick pivot (middle element = 10):

Step 2 — Partition:
    Left (x < 10):  [3, 6, 8, 1, 2, 1]
    Middle (x == 10): [10]
    Right (x > 10): []

Step 3 — Recursively sort left [3, 6, 8, 1, 2, 1]:
    Pivot = 8
    Left: [3, 6, 1, 2, 1]
    Middle: [8]
    Right: []

Step 4 — Keep dividing until single elements:
    Eventually: [1, 1, 2, 3, 6, 8] + [10] = [1, 1, 2, 3, 6, 8, 10] ✓

The array is sorted by repeatedly picking pivots and partitioning."
recap_text = "- Pick a pivot, partition into smaller/larger/equal
- Recursively sort each half
- Time: O(n log n) average, O(n²) worst (bad pivot choices)
- Space: O(log n) for recursion
- Very fast in practice — widely used
- Not stable: equal elements may swap order"
challenge_instruction = "Arrange the blocks to pick a pivot and partition the array into smaller and larger halves."
challenge_blocks = Array[String](["pivot = arr[len(arr) // 2]", "left = []", "right = []", "for x in arr:", "if x < pivot: left.append(x)", "if x > pivot: right.append(x)", "print(left, pivot, right)", "arr = [3, 6, 8, 1]", "if x == pivot:"])
correct_sequence = Array[String](["arr = [3, 6, 8, 1]", "pivot = arr[len(arr) // 2]", "left = []", "right = []", "for x in arr:", "if x < pivot: left.append(x)", "if x > pivot: right.append(x)", "print(left, pivot, right)"])
