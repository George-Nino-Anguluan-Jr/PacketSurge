print(left, pivot, right)"
expected_output = "[1, 2] 5 [8]"
challenge_hint = "Pick the middle element as pivot using arr[len(arr) // 2]. Create empty left and right lists. Loop through every element in arr: if it's smaller than pivot, add it to left; if it's larger, add it to right. Print left, pivot, and right to see the partition."
practice_question = "What is the average time complexity of Quick Sort?"
practice_options = Array[String](["O(n²)", "O(n log n)", "O(log n)", "O(n)"])
practice_correct_index = 1
practice_explanation = "Quick Sort averages O(n log n). Each partition roughly halves the array, doing O(n) work per level. The worst case O(n²) happens when the pivot is always the smallest or largest element."
