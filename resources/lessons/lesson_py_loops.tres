[resource]
script = ExtResource("1_46n2l")
lesson_id = "py_loops"
title = "Loops"
category = "python"
icon_text = "↺"
prerequisites = Array[String](["py_lists"])
concept_text = "A loop lets you run the same code multiple times.
Instead of repeating yourself, write the code once inside a loop.

For loop — repeats for each item:
    for i in range(5):
        print(i)
    # Prints: 0 1 2 3 4

While loop — repeats while a condition is true:
    count = 1
    while count <= 3:
        print(count)
        count = count + 1
    # Prints: 1 2 3

Loops save time and make your code shorter."
real_world_example = "Imagine printing tickets for 5 guests.
Without a loop, you'd write print(\"ticket\") five times.
With a loop:

    for guest in range(5):
        print(\"Ticket printed\")

    # Output:
    # Ticket printed
    # Ticket printed
    # Ticket printed
    # Ticket printed
    # Ticket printed

The loop handles the repetition for you."
guided_example = "Let's count even numbers from 2 to 10.

Step 1 — Use range with step:
    for num in range(2, 11, 2):
        print(num)
    # Output: 2 4 6 8 10

Step 2 — Loop through names:
    players = [\"Ana\", \"Bob\", \"Eve\"]
    for p in players:
        print(\"Hello,\", p)
    # Output:
    # Hello, Ana
    # Hello, Bob
    # Hello, Eve

Step 3 — Use a while loop:
    x = 1
    while x <= 5:
        print(x * 2)
        x = x + 1
    # Output: 2 4 6 8 10"
recap_text = "- for loops iterate over items or a range of numbers
- while loops run as long as a condition is True
- range(n) gives numbers 0 to n-1
- range(start, stop, step) gives custom sequences
- Use loops to avoid repeating code
- Indent the code inside the loop with 4 spaces"
challenge_instruction = "Arrange the blocks to print numbers 1 to 5 using a while loop."
challenge_blocks = Array[String](["num = 1", "while num <= 5:", "    print(num)", "    num = num + 1", "for num in range(5):", "while num > 5:"])
correct_sequence = Array[String](["num = 1", "while num <= 5:", "    print(num)", "    num = num + 1"])
code_template = "count = ___
while count <= 5:
    print(count)
    count = count + ___"
challenge_code = "count = 1
while count <= 5:
    print(count)
    count = count + 1"
expected_output = "1
2
3
4
5"
challenge_hint = "Start with count = 1. Use while count <= 5: to keep looping. Inside, print count then add 1 each time."
practice_question = "How many times does this loop print?    for i in range(4):    print(i)"
practice_options = Array[String](["3", "4", "5", "0"])
practice_correct_index = 1
practice_explanation = "range(4) generates 0, 1, 2, 3 — that's 4 values. So the loop body runs 4 times. Note: range(4) gives 0 through 3, not 1 through 4."
