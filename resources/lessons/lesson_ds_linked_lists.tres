[resource]
script = ExtResource("1_5ypmi")
lesson_id = "ds_linked_lists"
title = "Linked Lists"
category = "data_structures"
icon_text = "→→"
prerequisites = Array[String](["ds_queues"])
visualization_scene = ExtResource("2_1p6j0")
concept_text = "A linked list is a chain of nodes where each node holds a value and points to the next node.

Unlike arrays, nodes are not stored in consecutive memory spots.
Each node knows where the next one is.

    Node1               Node2               Node3
    [value | next] →    [value | next] →    [value | next] → None

Types of linked lists:
- Singly: each node points only forward
- Doubly: each node points forward and backward
- Circular: last node points back to the first

Key speeds:
- Access: slow O(n) — must walk the chain
- Insert at known position: fast O(1)
- Delete at known position: fast O(1)"
real_world_example = "Think of a treasure hunt where each clue leads to the next.

    Clue 1: \"Check the tree\" → Clue 2: \"Look under the rock\"
    → Clue 3: \"Open the chest\" → Done

Each clue knows only the location of the next clue.
You must follow the chain from the start — you can't jump to Clue 3.

Doubly linked: like a music playlist where you can skip forward or go back to the previous song.

Circular linked: like a board game where turns cycle from the last player back to the first."
guided_example = "Let's build a simple chain of two nodes.

Step 1 — Create two node values:
    node1_val = 5
    node2_val = 10

Step 2 — Link them (node1 → node2):
    node1_next = \"node2\"

Step 3 — Start at the head and follow:
    current = \"node1\"
    while current != None:
        if current == \"node1\":
            print(node1_val)
            current = node1_next
        elif current == \"node2\":
            print(node2_val)
            current = None

    Output:
    5
    10

This shows the core idea: each node knows the next one.
You walk from the head through the chain until you hit None."
recap_text = "- Linked lists store nodes connected by pointers
- Singly: each node has a next pointer
- Doubly: each node has next and prev pointers
- Access is O(n) — must follow the chain
- Insert/delete at known position is O(1)
- No fixed size limit — grows dynamically"
challenge_instruction = "Arrange the blocks to create two linked nodes and print the first one's value."
challenge_blocks = Array[String](["first = 7", "second = 3", "next_node = \"second\"", "print(first)", "print(second)", "first = 7 second = 3"])
correct_sequence = Array[String](["first = 7", "second = 3", "next_node = \"second\"", "print(first)"])
challenge_hint = "Create the node values with variables. The next pointer can be a string naming the next node. Print the head node's value."
code_template = "head = ___
tail = ___
print(\"Head:\", head)
print(\"Tail:\", tail)"
challenge_code = "head = 10
tail = 20
print(\"Head:\", head)
print(\"Tail:\", tail)"
expected_output = "Head: 10\nTail: 20"
challenge_hint = "Create variables for each node's value. The first node is the head, the last is the tail."
practice_question = "How do you access a specific item in a singly linked list?"
practice_options = Array[String](["Directly by index, like an array", "You must follow the chain from the head", "You use a hash function", "Items are accessed randomly"])
practice_correct_index = 1
practice_explanation = "Linked lists don't have indexes like arrays. To find an item, you must start at the head node and follow the next pointers until you find the value you're looking for. This takes O(n) time."
