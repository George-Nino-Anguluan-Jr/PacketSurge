[resource]
script = ExtResource("1_5ypmi")
lesson_id = "ds_linked_lists"
title = "Linked Lists"
category = "data_structures"
icon_text = "→→"
prerequisites = Array[String](["ds_queuesds_queues"])
visualization_scene = ExtResource("2_1p6j0")
concept_text = "A Linked List is a data structure where elements (nodes) are stored in sequence, but not in consecutive memory locations. Instead, each node contains a value and a pointer (or reference) to other nodes in the sequence.

There are three basic forms of linked lists:

1. Singly Linked Lists:
   - Each node contains a value AND a single pointer \"next\" pointing to the next node.
   - Traversal can only be done in one direction (forward).
   - The last node points to None/Null.
   - [ value | next → ] → [ value | next → ] → None

2. Doubly Linked Lists:
   - Each node contains a value AND two pointers: \"next\" (to the next node) and \"prev\" (to the previous node).
   - Allows bi-directional traversal (forward and backward).
   - Requires more memory for the extra pointer.
   - None ← [ prev | value | next ] ↔ [ prev | value | next ] → None

3. Circular Linked Lists:
   - The last node's \"next\" pointer points back to the first node (head), instead of pointing to None.
   - Can be Singly or Doubly linked.
   - Useful for circular loops (like round-robin scheduling or board game turns).
   - [ value | next → ] → [ value | next → ] → (loops back to head)"
real_world_example = "Let's look at real-world examples for each type:

1. Singly Linked List: A scavenger hunt where each clue leads to the next. You can't go backward because you don't know where you came from, only where to go next!
   - Clue1 → Clue2 → Clue3 → None

2. Doubly Linked List: Web Browser History or Music Playlist. You can click \"Next\" (forward) to go to the next page/song, or \"Back\" (backward) to return to the previous page/song!
   - Page1 ↔ Page2 ↔ Page3

3. Circular Linked List: A multiplayer board game (like Monopoly) where players take turns. After the last player (Player 4) completes their turn, the turn loops back to the first player (Player 1)!
   - Player1 → Player2 → Player3 → Player4 → (loops back to Player1)"
guided_example = "Let's see how each of these is implemented in Python:

1. Singly Linked List Node:
    class SinglyNode:
        def __init__(self, value):
            self.value = value
            self.next = None

2. Doubly Linked List Node:
    class DoublyNode:
        def __init__(self, value):
            self.value = value
            self.next = None
            self.prev = None

3. Circular Linked List (Singly-based):
    # Setup a circular loop of 2 nodes
    head = SinglyNode(10)
    second = SinglyNode(20)
    head.next = second
    second.next = head  # Loops back to head!"
recap_text = "- Linked Lists store nodes dynamically without a fixed size in memory.
- Singly Linked Lists only point forward. Simple to implement, low memory overhead, but unidirectional.
- Doubly Linked Lists point both forward and backward. Bi-directional traversal, but uses extra memory.
- Circular Linked Lists loop back from the tail to the head. Great for round-robin applications and repeating queues.
- Key complexities: Access O(n), Search O(n), Insertion/Deletion O(1) (if node position is known)."
challenge_instruction = "Arrange the blocks to set up a Doubly Linked List node, then set up two nodes connected bi-directionally."
challenge_blocks = Array[String](["class Node:    def __init__(self, value):        self.value = value        self.next = None        self.prev = None", "a = Node(1)", "b = Node(2)", "a.next = b", "b.prev = a", "a.value = b", "b.value = a"])
correct_sequence = Array[String](["class Node:    def __init__(self, value):        self.value = value        self.next = None        self.prev = None", "a = Node(1)", "b = Node(2)", "a.next = b", "b.prev = a"])
challenge_hint = "Define the Node class with both next and prev attributes. Instantiate nodes a and b, then link a.next to b, and b.prev back to a."
practice_question = "Which type of linked list allows traversing backwards and forwards, but uses the most memory per node?"
practice_options = Array[String](["Singly Linked List", "Doubly Linked List", "Circular Singly Linked List", "Array List"])
practice_correct_index = 1
practice_explanation = "Doubly Linked Lists store both \"next\" and \"prev\" pointers for every node, allowing complete bi-directional traversal at the cost of additional memory overhead per node."
