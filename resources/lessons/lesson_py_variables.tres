[resource]
script = ExtResource("1_38uo3")
lesson_id = "py_variables"
title = "Variables"
category = "python"
icon_text = "[x]"
visualization_scene = ExtResource("2_3o5rh")
concept_text = "A variable is a named container that stores a value.
Think of it like a labeled box — you put something
inside it and refer to it by the label whenever you need it.

In Python, you create a variable like this:
    name = \"Alice\"
    age = 17
    score = 0

The variable name is on the left.
The value is on the right.
The = sign assigns the value to the name."
real_world_example = "Imagine a scoreboard at a basketball game.
The scoreboard has a label \"HOME\" and shows a number.
That number changes as the game goes on.

In Python:
    home_score = 0
    home_score = 42

The label (home_score) stays the same.
The value inside it can change anytime."
guided_example = "Let's create variables for a student profile.

Step 1 — Store the student's name:
    student_name = \"Maria\"

Step 2 — Store their year level:
    year_level = 1

Step 3 — Store their current grade:
    grade = 88.5

Step 4 — Print them out:
    print(student_name)
    print(year_level)
    print(grade)

Output:
    Maria
    1
    88.5"
recap_text = "- A variable stores a value under a name
- Use = to assign a value to a variable
- Variable names should be descriptive
- Values can be text (str), numbers (int/float), or true/false (bool)
- Variables can be updated anytime by assigning a new value"
challenge_instruction = "Arrange the blocks to create two variables,assign them values, then print both."
challenge_blocks = Array[String](["name = \"PlayerOne\"", "score = 0", "print(name)", "print(score)", "= \"PlayerOne\" name", "0 = score"])
correct_sequence = Array[String](["name = \"PlayerOne\"", "score = 0", "print(name)", "print(score)"])
challenge_hint = "Variable assignment: name = valueThe variable name goes FIRST, then =, then the value.Use print(name) to display it."
code_template = "name = \"___\"
score = ___
print(name)
print(score)"
challenge_code = "name = \"PlayerOne\"
score = 0
print(name)
print(score)"
expected_output = "PlayerOne
0"
practice_question = "Which of the following correctly creates a variable called 'lives' with a value of 3?"
practice_options = Array[String](["3 = lives", "lives == 3", "lives = 3", "var lives = 3"])
practice_correct_index = 2
practice_explanation = "In Python, variables are assigned using a single = sign.The variable name goes on the LEFT, the value on the RIGHT.lives = 3 is correct.Note: == is for comparison, not assignment.var is used in other languages like JavaScript, not Python."
