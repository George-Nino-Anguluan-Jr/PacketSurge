[resource]
script = ExtResource("1_38uo3")
lesson_id = "py_variables"
title = "Variables"
category = "python"
icon_text = "[x]"
visualization_scene = ExtResource("2_3o5rh")
concept_text = "Think of a variable as a labeled box where you can store one piece of information. The label is the name you give it. The thing inside the box is the value.

You create a variable (put something in the box) using the equals sign =. The name goes on the LEFT, the value goes on the RIGHT.

    name = \"Alex\"

This reads as: \"create a variable called name and put the text 'Alex' inside it\".

Why does this matter? Because programs need to REMEMBER things. When a player picks up a coin, the game stores the new score somewhere. When you type your name on a website, the site stores it. Variables are how programs remember.

You can also CHANGE what's inside the box anytime. Just use the same name with a new value:

    score = 10      # score is now 10
    score = 20      # score is now 20 (the 10 is gone)

Python automatically figures out the type — text (str), whole numbers (int), decimals (float), or true/false (bool). You don't have to declare the type yourself."
real_world_example = "Imagine a small whiteboard on your fridge. You write \"Monday: Pizza\" on it, and the family sees it. Tomorrow you erase it and write \"Tuesday: Tacos\". The whiteboard label (the variable) stays the same — it's still YOUR family whiteboard — but the content (the value) changes every day.

That's exactly what a variable does:

    dinner = \"Pizza\"
    print(dinner)     # shows: Pizza

    dinner = \"Tacos\"
    print(dinner)     # shows: Tacos

The name `dinner` stays. The value changes. Programs work the same way: the variable name is fixed, but the value can be replaced as the program runs.

Another example: your phone's battery percentage. It's a number that goes up while charging and down while using. The name (\"battery\") never changes, but the value updates constantly:

    battery = 87
    battery = 84
    battery = 12
    # ... and so on"
guided_example = "Let's build a tiny player profile together, one line at a time. Don't rush — read each step.

Step 1 — Pick a name. We store it in a variable called username.

    username = \"ProGamer99\"

Think of this as writing \"ProGamer99\" on a label and sticking it on a box. The box is now called username.

Step 2 — Pick a level. Levels are whole numbers, so no quotes needed.

    level = 5

Notice: no quotes around 5. Quotes are for text. Numbers don't need them.

Step 3 — Pick health. Health starts high.

    health = 100

Same idea — whole number, no quotes.

Step 4 — Show everything. We use print() to display each value.

    print(username)
    print(level)
    print(health)

Output:
    ProGamer99
    5
    100

Step 5 — Try changing a value. Let's say the player took damage.

    health = 75
    print(health)    # shows: 75

The box still has the name \"health\", but the number inside changed from 100 to 75. The old value (100) is replaced — it's gone forever, unless we saved it somewhere else.

That's it! You just wrote a tiny program that stores and updates player info."
recap_text = "- A variable is a labeled box that holds one value
- Use = to assign: name = value
- The name goes on the LEFT, the value on the RIGHT
- Text needs quotes: name = \"Alex\"
- Numbers don't need quotes: score = 100
- Python picks the type for you (str, int, float, bool)
- You can replace a value anytime — just assign again
- The old value is forgotten unless you saved it elsewhere
- Variable names should describe what they hold (health, score, name)"
challenge_instruction = "Drag the blocks to store a player's high score and lives, then display both."
challenge_blocks = Array[String](["score = 100", "lives = 3", "print(score)", "print(lives)"])
correct_sequence = Array[String](["score = 100", "lives = 3", "print(score)", "print(lives)"])
challenge_hint = "Two assignments (use =) then two prints. Name on the left, value on the right."
