[resource]
script = ExtResource("1_38uo3")
lesson_id = "py_variables"
title = "Variables"
category = "python"
icon_text = "[x]"
visualization_scene = ExtResource("2_3o5rh")
concept_text = "A variable is like a labeled box where you store information.
You give it a name and put a value inside.

Example:
    player_name = \"Alex\"
    player_score = 100
    is_ready = True

The variable name goes on the LEFT of the = sign.
The value goes on the RIGHT.

Python automatically knows the type of data stored."
real_world_example = "Imagine a whiteboard where you write the daily special.
You erase and rewrite it every day — same label, new value.

    special = \"Monday: Pizza\"
    print(special)

    special = \"Tuesday: Pasta\"
    print(special)

The label \"special\" stays the same, but the value changes.
This is how variables work in Python."
guided_example = "Let's create a player profile.

Step 1 — Store the player name:
    username = \"ProGamer99\"

Step 2 — Store their level:
    level = 5

Step 3 — Store their health:
    health = 100

Step 4 — Display everything:
    print(username)
    print(level)
    print(health)

Output:
    ProGamer99
    5
    100"
recap_text = "- Variables store data under a name
- Use = to assign: name = value
- Variable names should describe what they hold
- Common types: str (text), int (whole number), float (decimal), bool (True/False)
- You can change a variable's value anytime
- Variables must be created before use"
challenge_instruction = "Arrange the blocks to store a player's high score and lives, then display both."
challenge_blocks = Array[String](["high_score = 9999", "lives = 3", "print(high_score)", "print(lives)", "9999 = high_score", "print high_score"])
correct_sequence = Array[String](["high_score = 9999", "lives = 3", "print(high_score)", "print(lives)"])
challenge_hint = "Create variables with: name = value. The name goes on the LEFT of =. Use print(name) to display it."
code_template = "game = \"___\"
level = ___
print(game)
print(level)"
challenge_code = "game = \"Super Mario\"
level = 1
print(game)
print(level)"
expected_output = "Super Mario
1"
practice_question = "What will this code do?    x = 5    print(x)"
practice_options = Array[String](["Show the number 5", "Show the letter x", "Cause an error", "Show \"x\""])
practice_correct_index = 0
practice_explanation = "The variable x stores the value 5. When you write print(x), Python looks up the value stored in x and prints 5. It does NOT print the letter 'x'."
