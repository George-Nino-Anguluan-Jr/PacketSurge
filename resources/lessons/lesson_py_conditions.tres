[resource]
script = ExtResource("1_artpg")
lesson_id = "py_conditions"
title = "Conditions"
category = "python"
icon_text = "?"
prerequisites = Array[String](["py_loops"])
visualization_scene = ExtResource("2_iddpb")
concept_text = "Conditions let your code make decisions.
Check if something is True or False and run different code.

Python uses if, elif, and else:
    age = 18
    if age >= 18:
        print(\"Adult\")
    else:
        print(\"Minor\")
    # Output: Adult

Comparison operators:
    ==  equal to
    !=  not equal
    >   greater than
    <   less than
    >=  greater or equal
    <=  less or equal"
real_world_example = "A traffic light system decides what to do:

    light_color = \"red\"

    if light_color == \"green\":
        print(\"Go!\")
    elif light_color == \"yellow\":
        print(\"Slow down\")
    else:
        print(\"Stop\")

    # Output: Stop

The program checks each condition from top to bottom.
The first matching condition runs, and the rest are skipped."
guided_example = "Let's write a temperature guide.

Step 1 — Set temperature:
    temp = 30

Step 2 — Add conditions:
    if temp > 35:
        print(\"Very hot!\")
    elif temp > 25:
        print(\"Warm\")
    elif temp > 15:
        print(\"Cool\")
    else:
        print(\"Cold\")

    # Output: Warm

Step 3 — Test with different values:
    temp = 10  → \"Cold\"
    temp = 40  → \"Very hot!\"
    temp = 20  → \"Cool\""
recap_text = "- if runs code when a condition is True
- elif checks another condition if previous ones were False
- else catches everything that didn't match
- Use == to compare values
- Use >, <, >=, <= for number comparisons
- Conditions are checked top to bottom
- Indent the code inside each condition"
challenge_instruction = "Arrange the blocks to check if a number is positive, negative, or zero."
challenge_blocks = Array[String](["number = -5", "if number > 0:", "    print(\"Positive\")", "elif number < 0:", "    print(\"Negative\")", "else:", "    print(\"Zero\")", "if number > 0", "    print \"Positive\""])
correct_sequence = Array[String](["number = -5", "if number > 0:", "    print(\"Positive\")", "elif number < 0:", "    print(\"Negative\")", "else:", "    print(\"Zero\")"])
code_template = "num = ___
if num > 0:
    print(\"___\")
elif num < 0:
    print(\"Negative\")
else:
    print(\"___\")"
challenge_code = "num = 7
if num > 0:
    print(\"Positive\")
elif num < 0:
    print(\"Negative\")
else:
    print(\"Zero\")"
expected_output = "Positive"
challenge_hint = "Start with a number. Use if/elif/else to check if it's above, below, or equal to zero. Don't forget the colons :"
practice_question = "What does this code print?    x = 7    if x > 10: print(\"Big\")    else: print(\"Small\")"
practice_options = Array[String](["Big", "Small", "7", "Nothing"])
practice_correct_index = 1
practice_explanation = "Since 7 is NOT greater than 10, the if condition is False. The else block runs instead and prints \"Small\"."
