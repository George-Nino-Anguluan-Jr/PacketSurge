[resource]
script = ExtResource("1_3d2s1")
lesson_id = "sort_radix"
title = "Radix Sort"
category = "data_structures"
icon_text = "0→9"
prerequisites = Array[String](["sort_counting"])
visualization_scene = ExtResource("2_rd84h")
concept_text = "Radix Sort sorts numbers digit by digit, from least significant (ones place) to most significant.

It uses Counting Sort as a helper for each digit position.

How it works on [170, 45, 75, 90, 2, 24]:

    Pass 1 (ones digit): sort by last digit
    [170, 90, 2, 24, 45, 75]

    Pass 2 (tens digit): sort by middle digit
    [2, 24, 45, 75, 170, 90]

    Pass 3 (hundreds digit): sort by first digit
    [2, 24, 45, 75, 90, 170] ✓

Time: O(d × n) where d is the number of digits
Space: O(n + k) for the counting sort helper"
real_world_example = "Radix Sort is great for integer-heavy data:
- Sorting millions of phone numbers or IDs
- Network routing (sorting IP addresses)
- Card sorting machines (the original inspiration)
- DNA sequence sorting in bioinformatics

Any data that can be split into digit-like buckets can use Radix Sort."
guided_example = "Let's trace Radix Sort on [170, 45, 75, 90, 2, 24].

Step 1 — Sort by ones digit:
    Look at last digit of each number:
    170→0, 90→0, 2→2, 24→4, 45→5, 75→5
    After sorting: [170, 90, 2, 24, 45, 75]

Step 2 — Sort by tens digit:
    Look at middle digit:
    2→0, 24→2, 45→4, 75→7, 90→9, 170→7
    After sorting: [2, 24, 45, 75, 170, 90]

Step 3 — Sort by hundreds digit:
    Look at first digit:
    2→0, 24→0, 45→0, 75→0, 90→0, 170→1
    After sorting: [2, 24, 45, 75, 90, 170] ✓ Sorted!

Each pass preserves the order from the previous pass, so the final result is correct."
recap_text = "- Sort numbers digit by digit, from rightmost to leftmost
- Uses Counting Sort as a helper for each digit
- Time: O(d × n) where d is the number of digits
- Space: O(n + k) for the helper sort
- Fast for integers with a limited digit count
- Also works for strings and other sequence-based data"
challenge_instruction = "Arrange the blocks to extract each digit using place value and print a number's digits."
challenge_blocks = Array[String](["num = 123", "ones = num % 10", "tens = (num // 10) % 10", "hundreds = num // 100", "print(ones, tens, hundreds)", "tens = num % 10", "hundreds = num % 100"])
correct_sequence = Array[String](["num = 123", "ones = num % 10", "tens = (num // 10) % 10", "hundreds = num // 100", "print(ones, tens, hundreds)"])
code_template = "num = 456
ones = num % 10
tens = (num // ___) % 10
hundreds = num // 100
print(ones, tens, hundreds)"
challenge_code = "num = 456
ones = num % 10
tens = (num // 10) % 10
hundreds = num // 100
print(ones, tens, hundreds)"
expected_output = "6 5 4"
challenge_hint = "Get the ones digit first: num % 10 gives the last digit. For the tens digit: divide by 10 first to shift one place right (num // 10), then % 10 again. For the hundreds digit: divide by 100 to shift two places right."
practice_question = "Which digit does Radix Sort start sorting from?"
practice_options = Array[String](["Most significant (leftmost)", "Least significant (rightmost)", "Middle digit", "The largest digit"])
practice_correct_index = 1
practice_explanation = "Radix Sort starts from the least significant digit (ones place, rightmost) and works toward the most significant digit. This preserves the relative order from previous passes."

